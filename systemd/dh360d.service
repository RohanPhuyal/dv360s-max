[Unit]
Description=Darkflash DH360D AIO LCD — stream host sensors to the pump screen
Documentation=https://github.com/clarkse/dh360d
# Start once the basic system is up; the daemon waits/retries for the device itself.
After=multi-user.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/dh360d
ExecStart=/usr/bin/dh360d daemon
Restart=always
RestartSec=5
# The daemon reconnects on its own, but keep systemd resilient too.

# Light hardening (the daemon only needs the serial port + /sys hwmon, both fine here).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
