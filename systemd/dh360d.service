[Unit]
Description=Darkflash DH360D AIO LCD — stream host sensors to the pump screen
Documentation=https://github.com/clarkse/dh360d
# Deliberately NOT ordered After=multi-user.target. The udev rule tags the cooler with
# SYSTEMD_WANTS=dh360d.service, so this starts the moment the CH340 enumerates. Ordering
# after multi-user.target made the start job wait on the whole boot transaction: a hung
# plymouth-quit-wait.service once left it queued (never dispatched) for a week.
# The daemon waits/retries for the device itself, so it needs no ordering of its own.

[Service]
Type=simple
EnvironmentFile=-/etc/default/dh360d
ExecStart=/usr/bin/dh360d daemon
Restart=always
RestartSec=5
# The daemon reconnects on its own, but keep systemd resilient too.

# Light hardening (the daemon only needs the serial port + /sys hwmon, both fine here).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
